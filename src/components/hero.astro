<section class="hero" id="top">
  <canvas id="net" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="mm eyebrow rv">Zürich · Introductions since 2014<span class="cursor"></span></div>
    <h1 class="disp hero-title rv d1">We make the<br />connection.<br /><span class="hero-accent">You make the deal.</span></h1>
    <p class="lead rv d2">Private introductions between capital and opportunity. Swiss, independent, discreet.</p>
    <div class="rv d3"><a class="btn btn-p" href="#contact">Request an introduction <span aria-hidden="true">→</span></a></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  #net {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    -webkit-mask-image: radial-gradient(120% 100% at 78% 50%, #000 45%, rgba(0, 0, 0, 0.4) 80%, transparent 100%);
    mask-image: radial-gradient(120% 100% at 78% 50%, #000 45%, rgba(0, 0, 0, 0.4) 80%, transparent 100%);
  }

  .hero .wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 36px;
    padding-top: 168px;
    padding-bottom: 160px;
  }

  .hero .eyebrow {
    color: #8f8a87;
  }

  .hero-title {
    max-width: 820px;
    margin: 0;
    font-size: 96px;
    line-height: 1.02;
  }

  .hero-accent {
    color: var(--accent);
    font-style: italic;
    font-weight: 400;
  }

  @media (max-width: 860px) {
    .hero .wrap {
      padding-top: 96px;
      padding-bottom: 96px;
    }

    .hero-title {
      font-size: 48px;
    }
  }
</style>

<script>
(function(){
  // reveal on scroll
  var els=document.querySelectorAll('.rv');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.15});
    els.forEach(function(e){io.observe(e)});
  }else{els.forEach(function(e){e.classList.add('in')})}

  // hero: "the introduction" — two-depth network; arcs connect distant nodes, then step aside
  var c=document.getElementById('net');if(!c)return;
  var reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ctx=c.getContext('2d'),W,H,dpr=Math.min(window.devicePixelRatio||1,2),mx=-1e4,my=-1e4,far=[],near=[],arcs=[],nextAt=0,prev=0,run=true,ox=0,oy=0;
  var SAGE='179,162,101',INK='228,224,219';
  function mk(n,sp){var a=[];for(var i=0;i<n;i++)a.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*sp,vy:(Math.random()-.5)*sp,hot:0});return a}
  function size(){var r=c.parentNode.getBoundingClientRect();W=r.width;H=r.height;c.width=W*dpr;c.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);far=mk(Math.round(Math.min(130,W*H/8000)),.12);near=mk(Math.round(Math.min(70,W*H/17000)),.3);arcs=[]}
  size();window.addEventListener('resize',size);
  c.parentNode.addEventListener('mousemove',function(e){var r=c.getBoundingClientRect();mx=e.clientX-r.left;my=e.clientY-r.top});
  c.parentNode.addEventListener('mouseleave',function(){mx=my=-1e4});
  if('IntersectionObserver' in window)new IntersectionObserver(function(e){run=e[0].isIntersecting;if(run&&!reduce)requestAnimationFrame(frame)}).observe(c);
  function spawn(){for(var k=0;k<30;k++){var a=near[Math.random()*near.length|0],b=near[Math.random()*near.length|0];if(a===b)continue;var dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy);if(d>220&&d<620){var s=Math.random()<.5?1:-1;arcs.push({a:a,b:b,t:0,k:s*d*.28});return}}}
  function q(A,u){var a=A.a,b=A.b,mxp=(a.x+b.x)/2,myp=(a.y+b.y)/2,dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy)||1,cx=mxp-dy/d*A.k,cy=myp+dx/d*A.k,v=1-u;return[v*v*a.x+2*v*u*cx+u*u*b.x,v*v*a.y+2*v*u*cy+u*u*b.y]}
  function ease(x){return x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2}
  function frame(ts){
    ts=ts||0;var dt=Math.min(50,ts-prev||16);prev=ts;
    var tx=mx>-1e3?(mx-W/2)*-.015:0,ty=mx>-1e3?(my-H/2)*-.015:0;ox+=(tx-ox)*.05;oy+=(ty-oy)*.05;
    ctx.clearRect(0,0,W,H);
    var i,j,p,o;
    for(i=0;i<far.length;i++){p=far[i];if(!reduce){p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1}ctx.fillStyle='rgba('+INK+',.26)';ctx.fillRect(p.x+ox*.4,p.y+oy*.4,1,1)}
    for(i=0;i<near.length;i++){p=near[i];if(!reduce){p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1}p.hot=Math.max(0,p.hot-dt/1400)}
    ctx.lineWidth=1;
    for(i=0;i<near.length;i++)for(j=i+1;j<near.length;j++){var a=near[i],b=near[j],d=Math.hypot(a.x-b.x,a.y-b.y);if(d<130){ctx.strokeStyle='rgba('+INK+','+(.15*(1-d/130))+')';ctx.beginPath();ctx.moveTo(a.x+ox,a.y+oy);ctx.lineTo(b.x+ox,b.y+oy);ctx.stroke()}}
    if(mx>-1e3)for(i=0;i<near.length;i++){p=near[i];var dm=Math.hypot(mx-p.x-ox,my-p.y-oy);if(dm<170){ctx.strokeStyle='rgba('+SAGE+','+(.45*(1-dm/170))+')';ctx.beginPath();ctx.moveTo(mx,my);ctx.lineTo(p.x+ox,p.y+oy);ctx.stroke();p.hot=Math.max(p.hot,.6)}}
    if(!reduce&&ts>nextAt&&arcs.length<4){spawn();nextAt=ts+700+Math.random()*700}
    for(i=arcs.length-1;i>=0;i--){var A=arcs[i];A.t+=reduce?3000:dt;var pr=ease(Math.min(1,A.t/1200)),fade=A.t<1200?1:Math.max(0,1-(A.t-1200)/1800);
      ctx.strokeStyle='rgba('+INK+','+(.30*fade)+')';ctx.lineWidth=1;ctx.beginPath();
      for(j=0;j<=40;j++){o=q(A,pr*j/40);if(j)ctx.lineTo(o[0]+ox,o[1]+oy);else ctx.moveTo(o[0]+ox,o[1]+oy)}ctx.stroke();
      if(A.t<1200){o=q(A,pr);ctx.shadowColor='rgba('+INK+',.8)';ctx.shadowBlur=10;ctx.fillStyle='rgba('+INK+',.75)';ctx.beginPath();ctx.arc(o[0]+ox,o[1]+oy,2.2,0,6.283);ctx.fill();ctx.shadowBlur=0;A.a.hot=1}
      else{A.b.hot=Math.max(A.b.hot,fade);var rr=(A.t-1200)/700;if(rr<1){ctx.strokeStyle='rgba('+INK+','+(.25*(1-rr))+')';ctx.beginPath();ctx.arc(A.b.x+ox,A.b.y+oy,4+rr*18,0,6.283);ctx.stroke();ctx.beginPath();ctx.arc(A.a.x+ox,A.a.y+oy,4+rr*18,0,6.283);ctx.stroke()}}
      if(A.t>3000&&!reduce)arcs.splice(i,1)}
    for(i=0;i<near.length;i++){p=near[i];var h=p.hot;ctx.fillStyle=h>.05?'rgba('+SAGE+','+(.5+.5*h)+')':'rgba('+INK+',.55)';ctx.beginPath();ctx.arc(p.x+ox,p.y+oy,1.4+h*1.4,0,6.283);ctx.fill()}
    if(!reduce&&run)requestAnimationFrame(frame);
  }
  if(reduce){spawn();spawn();}
  requestAnimationFrame(frame);
})();
</script>