---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum | MAME Capital">
  <main class="impressum">
    <div class="wrap">
      <a class="back" href="/"><img src="/images/mame-logo-on-dark.svg?v=8" alt="MAME Capital home" width="174" height="42" /></a>
      <h1>Impressum</h1>
      <address>
        <strong>MAME Capital GmbH</strong><br />
        Bahnhofstrasse 10<br />
        8001 Zürich<br />
        Switzerland
      </address>
      <p><a href="mailto:info@mamecapital.com">info@mamecapital.com</a></p>
      <p><a href="tel:+41434562510">+41 43 456 2510</a></p>
    </div>
  </main>
</Layout>

<style>
  .impressum {
    min-height: 100vh;
    background: #262a36;
    color: #e4e0db;
    font-family: 'Instrument Sans', system-ui, sans-serif;
  }

  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 64px 32px 144px;
  }

  .back {
    display: inline-block;
  }

  .back img {
    display: block;
    height: 42px;
    width: auto;
  }

  h1 {
    margin: 80px 0 40px;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 64px;
    font-weight: 400;
    line-height: 1.05;
  }

  address {
    color: #b8b3b0;
    font-size: 18px;
    font-style: normal;
    line-height: 1.75;
  }

  address strong {
    color: #e4e0db;
    font-weight: 500;
  }

  p {
    margin: 12px 0 0;
    font-size: 17px;
  }

  p:first-of-type {
    margin-top: 28px;
  }

  p a {
    color: #e4e0db;
    text-decoration: none;
  }

  p a:hover {
    color: #b3a265;
  }

  @media (max-width: 640px) {
    .wrap {
      padding-right: 16px;
      padding-left: 16px;
    }

    h1 {
      font-size: 48px;
    }
  }
</style>