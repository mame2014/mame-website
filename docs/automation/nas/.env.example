# Copy to .env on the NAS and fill in. Never commit the real .env.

# Long random string; encrypts the credentials n8n stores. Keep a copy in your password manager:
# losing it means re-entering all n8n credentials.
N8N_ENCRYPTION_KEY=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install connector (the long token after --token)
TUNNEL_TOKEN=
